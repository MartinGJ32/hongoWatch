---
const {
  name,
  priceFrom,
  priceTo,
  id,
  img
} = Astro.props;


---



<article class="bg-transparent p-3 hover:bg-white h-auto max-w-[250px] space-y-8 group relative" id="watch">
  <img src={img} alt="" class="cover"/>
  <div class="flex justify-between absolute top-62 left-18">
    <div class="absolute flex items-center justify-center opacity-0 translate-y-4 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0 gap-2" id="buttons">
      <button class="border border-dark bg-dark rounded p-1"><i class="fa-regular fa-heart text-white"></i></button>
      <button class="border border-dark bg-dark rounded p-1"><i class="fa-regular fa-eye text-white"></i></button>
       <button class="border border-dark bg-dark rounded p-1"><i class="fa-solid fa-cart-shopping text-white"></i></button>
    </div>
  </div>
  <div class="flex flex-col justify-center items-center">
    <h5 class="text-[14px] hover:text-gold">
      <a href={`/product/${id}`}>{name}</a>
    </h5>
    <p class="text-[14px] text-gray">£{priceFrom} - £{priceTo}</p>
  </div>
</article>

