---
const { title, description, image } = Astro.props;
---

<!-- the hero of every page -->
<section class="w-full h-100 relative items-center justify-center flex">
    <img
      src={image}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-dark/80"></div>
    <div class="z-10 relative flex flex-col items-center">
      <h2 class="text-white text-[40px]">{title}</h2>
      <p class="text-gray text-[14px]">{description}</p>
    </div>
  </section>