---
const {
  name,
  priceFrom,
  priceTo,
  id,
  img,
  imgDark
} = Astro.props;
---

<article class="bg-transparent p-3 lg:hover:bg-white dark:hover:bg-dark-surface-2 lg:max-h-[330px] lg:max-w-80 space-y-2 group overflow-hidden">
  <img
    src={img}
    alt={name}
    class="lg:w-[204px] lg:max-h-[260px] lg:group-hover:max-h-[220px] object-cover transition-all ease-out duration-300 block dark:hidden"
  />

  <img
    src={imgDark}
    alt={name}
    class="w-[204px] max-h-[260px] group-hover:max-h-[220px] object-cover transition-all ease-out duration-300 hidden dark:block"
  />

  <div class="flex-center-column">
    <h5 class="text-[14px] hover:text-gold dark:text-dark-text dark:hover:text-dark-gold">
      <a href={`/product/${id}`}>{name}</a>
    </h5>
    <p class="section-subtitle dark:text-dark-text-muted">
      £{priceFrom} - £{priceTo}
    </p>
  </div>

  <div class="flex justify-between lg:opacity-0 lg:group-hover:opacity-100 transition-all ease-out duration-300 self-end dark:text-dark-text">
    <button class="uppercase font-bold text-[11px] border-b-2">
      Add to cart
    </button>

    <div class="space-x-2">
      <button><i class="fa-regular fa-heart"></i></button>
      <button><i class="fa-solid fa-cart-shopping"></i></button>
    </div>
  </div>
</article>