---
const {
  name,
  priceFrom,
  priceTo,
  id,
  img
} = Astro.props;

---

<article class="bg-transparent p-3 hover:bg-white max-h-[330px] max-w-80 space-y-2 group overflow-hidden">
  <img src={img} alt="" class="w-[204px] max-h-[260px] group-hover:max-h-[220px] object-cover transition-all ease-out duration-300" />
  <div class="flex flex-col justify-center items-center">
    <h5 class="text-[14px] hover:text-gold">
      <a href={`/product/${id}`}>{name}</a>
    </h5>
    <p class="text-[14px] text-gray">£{priceFrom} - £{priceTo}</p>
  </div>
  <div class=" flex justify-between opacity-0 group-hover:opacity-100 transition-all ease-out duration-300 self-end">
    <button class="uppercase font-bold text-[11px] border-b-2">Add to cart</button>
    <div class="space-x-2">
      <button><i class="fa-regular fa-heart"></i></button>
      <button><i class="fa-solid fa-cart-shopping"></i></button>
    </div>
  </div>
</article>
