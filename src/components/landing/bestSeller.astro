---
/*I define the props*/
const {
  variant,
  title,
  price,
  image,
  id
} = Astro.props;

/*I define the possible spanClasses depending on the variant*/
const spanClasses: Record<string, string> = {
  normal: "",
  item2x2: "md:col-span-2",
  item4x4: "md:col-span-2 md:row-span-2",
};

/*I define the possible imgClasses depending on the variant*/
const imgClasses: Record<string, string> = {
  normal: "md:scale-105 lg:scale-110",
  item2x2: "md:rotate-90 md:scale-150 lg:scale-[2]",
  item4x4: "md:scale-110 lg:scale-[1.3]",
};
---

<article
  class:list={[
    
    "group flex w-full flex-col items-center gap-3 p-4 text-center",
    
    "md:relative md:h-full md:items-start md:justify-end md:overflow-hidden md:p-6 md:text-left lg:p-10",
    spanClasses[variant],
  ]}
>
  <a href={`/product/${id}`} class="block w-full md:absolute md:inset-0 md:z-0">
    <img
      src={image}
      alt={title}
      class:list={[
        "h-auto w-full object-contain",
        "md:h-full md:w-full md:origin-center md:object-top md:transition-transform md:duration-300",
        imgClasses[variant],
      ]}
    />
  </a>

  <div class="z-10 flex flex-col items-center md:absolute md:top-4 md:left-6 md:items-start lg:top-6 lg:left-10">
    <a href=""><h3 class="font-medium text-dark text-sm sm:text-base lg:text-lg">{title}</h3></a>
    <p class="text-gray text-xs sm:text-sm lg:text-base">{price}</p>
  </div>

  <div class="z-10 flex w-full items-center justify-end gap-3 opacity-100 transition-opacity duration-300 md:justify-between lg:opacity-0 lg:group-hover:opacity-100">
    <button class="text-[13px] underline decoration-2 underline-offset-2 sm:text-[14px] lg:text-[15px]">Add to cart</button>
    <div class="flex gap-4 text-sm sm:text-base lg:text-lg">
      <button aria-label="Add to wishlist"><i class="fa-regular fa-heart"></i></button>
      <button aria-label="Add to cart"><i class="fa-solid fa-cart-shopping"></i></button>
    </div>
  </div>
</article>