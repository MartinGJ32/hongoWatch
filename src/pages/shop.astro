---
import data from "../data/products.json";
import Layout from "../layouts/Layout.astro";
import teamImg from "../assets/images/contact/watch-the-team-01.jpg";
import womanBeachImg from "../assets/images/contact/contact-classic-img-22-1.jpg";
import beachImg from "../assets/images/contact/contact-classic-img-20.jpg";
import Hero from "../components/general/hero.astro";
import Watch from "../components/shop/watch.astro";
import PriceRange from "../components/shop/priceRange.astro";

let filtredWatches = [];

for (let i = 0; i < 4; i++) {
  filtredWatches.push(
    ...data.filter((product) => product.background === "white"),
  );
}
