<script>
  // Botones que eligen cuántas columnas se ven en la grilla de productos
  const productsGrid = document.getElementById("products-grid");
  const columnButtons = document.querySelectorAll(".view-columns-button");

  // clases de grid-cols que le corresponden a cada opción (mobile-first:
  // siempre 1 columna en pantallas chicas, y a partir de ahí escala hasta
  // el número elegido)
  const gridColumnsMap = {
    2: ["grid-cols-1", "sm:grid-cols-2"],
    3: ["grid-cols-1", "sm:grid-cols-2", "lg:grid-cols-3"],
    4: ["grid-cols-1", "sm:grid-cols-2", "lg:grid-cols-3", "xl:grid-cols-4"],
  };

  // todas las clases posibles, para sacarlas antes de poner las nuevas
  const allGridClasses = [
    "grid-cols-1",
    "sm:grid-cols-2",
    "lg:grid-cols-3",
    "xl:grid-cols-4",
  ];

  function setColumns(columns) {
    if (!productsGrid) return;

    productsGrid.classList.remove(...allGridClasses);
    productsGrid.classList.add(...gridColumnsMap[columns]);
  }

  function setActiveButton(activeButton) {
    columnButtons.forEach(function (button) {
      const isActive = button === activeButton;
      const spans = button.querySelectorAll("span");

      spans.forEach(function (span) {
        if (isActive) {
          span.classList.remove("border-gray/80", "bg-transparent");
          span.classList.add("border-transparent", "bg-gray/80");
        } else {
          span.classList.remove("border-transparent", "bg-gray/80");
          span.classList.add("border-gray/80", "bg-transparent");
        }
      });
    });
  }

  columnButtons.forEach(function (button) {
    button.addEventListener("click", function () {
      const columns = button.dataset.columns;
      setColumns(columns);
      setActiveButton(button);
    });
  });
</script>