---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/general/hero.astro";
import Manwarch from "../assets/images/shipping/watch-shipping-and-delivery-01.jpg";
import BirthdayImg from "../assets/images/shipping/watch-shipping-and-delivery-02.jpg.webp";
import Womanwarch from "../assets/images/shipping/watch-shipping-and-delivery-03.jpg.webp";

---

<Layout name="Hongo - Shipping and delivery">
  <!-- hero section -->
  <Hero
    title="Shipping and delivery"
    description="help in shipping & delivery"
    image={Manwarch.src}
  />




  <!--block section -->
  <section
    class="flex flex-col lg:flex-row w-full items-center justify-center h-auto py-10 px-4 sm:px-6 md:py-14 md:px-10 lg:py-20 lg:px-20 gap-8 md:gap-12 lg:gap-20 bg-white dark:bg-dark-bg"
  >
    <img src={BirthdayImg.src} class="w-full h-auto lg:w-[650px] lg:h-[530px]" alt="bottle rocket" />
