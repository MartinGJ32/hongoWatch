          alt="Image 3"
          class="thumbnail max-w-[115px] max-h-[145px] object-cover hover:opacity-70 cursor-pointer"
        />
        <img
          src="src\assets\images\product\watch-product-style-01-a.jpg.webp"
          alt="Image 3"
          class="thumbnail max-w-[115px] max-h-[145px] object-cover hover:opacity-70 cursor-pointer"
        />
      </div>
      <div class="flex overflow-hidden max-w-[539px] max-h-[675px]">
        <img
