              >
            </div>
          </div>
          <button
            class="flex items-center justify-center px-[25px] py-[8px] uppercase text-[14px] text-white bg-black border-2 border-transparent hover:text-black hover:bg-transparent hover:border-black"
            >add to cart</button
          >
        </div>
        <div class="flex items-center">
          <i class="fa-regular fa-heart text-[10px] text-gray"></i><button
            class="text-[10px] text-gray uppercase">Add to Wishlist</button
          >
        </div>
      </div>
      <div class="flex justify-between items-start">
        <div class="felx flex-col space-y-2">
          <p class="text-[11px] uppercase">
            Category: <a href="" class="text-gray hover:text-gold"
              >Product Style</a
            >
          </p>
          <p class="text-[11px] uppercase">
            tag: <a href="" class="text-gray hover:text-gold">Jackets</a>
          </p>
          <p class="text-[11px] uppercase">
            brand: <a href="" class="text-gray hover:text-gold">Halen cole</a
            >,<a href="" class="text-gray hover:text-gold">Hunting life</a>
          </p>
        </div><div class="flex gap-2">
          <a href="#"><i class="fa-brands fa-facebook-f text-[11px]"></i></a>
          <a href="#"><i class="fa-brands fa-x-twitter text-[11px]"></i></a>
          <a href="#"><i class="fa-brands fa-linkedin-in text-[11px]"></i></a>
          <a href="#"><i class="fa-brands fa-pinterest-p text-[11px]"></i></a>
        </div>
      </div>
    </div>
  </section>
  <section
    class="bg-white flex flex-col w-full justify-center items-center h-auto py-20 px-45 gap-15"
  >
    <div class="flex gap-10">
      <button id="descriptionBtn" class="text-[13px] uppercase border-b"
        >description</button
      ><button id="additionalInfoBtn" class="text-[13px] uppercase text-gray"
        >Additional information</button
      ><button id="reviewsBtn" class="text-[13px] uppercase text-gray"
        >Reviews (1)</button
      >
    </div>
    <div
      id="infoContainer"
      class="flex flex-col lg:flex-row items-start gap-8 border-b border-gray/20 pb-25"
    >
      <div class="flex flex-col flex-1 min-w-0 gap-10">
        <p class="text-gray text-[14px]">
          Lorem Ipsum is simply dummy text of the printing and typesetting
          industry. Lorem Ipsum has been the ‘s standard dummy text. Lorem Ipsum
          has been the industry’s standard dummy text ever since. Lorem Ipsum is
          simply dummy text. Lorem Ipsum is simply dummy text of the printing
          and typesetting industry. Lorem Ipsum has been the ‘s standard dummy
          text. Lorem Ipsum has been the industry’s standard dummy text ever
          since. Lorem Ipsum is simply dummy text.
        </p>
        <div>
          <h4 class="text-[14px]">01. Matte gunmetal stainless steel link</h4><p
            class="text-gray text-[14px]"
          >
            Any agreement with should have strong verification and enforcement
            safeguards to prevent future cheating.lorem Ipsum is simply dummy
            text of industry
          </p>
        </div>
        <div>
          <h4 class="text-[14px]">02. Brushed taupe stainless steel</h4><p
            class="text-gray text-[14px]"
          >
            Any agreement with should have strong verification and enforcement
            safeguards to prevent future cheating.lorem Ipsum is simply dummy
            text of industry
          </p>
        </div><div>
          <h4 class="text-[14px]">03. Gunmetal hands and black markers</h4><p
            class="text-gray text-[14px]"
          >
            Any agreement with should have strong verification and enforcement
            safeguards to prevent future cheating.lorem Ipsum is simply dummy
            text of industry
          </p>
        </div>
      </div>
      <img
        src="src\assets\images\product\watch-product-style-01-d.jpg.webp"
        alt=""
        class="flex-1 min-w-0 max-w-[550px] max-h-[520px] object-cover"
      />
    </div>
  </section>
</Layout>

<script>
  const zoomContainer = document.getElementById("zoomContainer");
  const thumbnails = document.querySelectorAll(".thumbnail");

  zoomContainer.addEventListener("mousemove", (e) => {
    const rect = zoomContainer.getBoundingClientRect();

    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;

    zoomContainer.style.transformOrigin = `${x}% ${y}%`;
    zoomContainer.style.transform = "scale(2)";
  });

  zoomContainer.addEventListener("mouseleave", () => {
    zoomContainer.style.transform = "scale(1)";
    zoomContainer.style.transformOrigin = "center";
  });

  thumbnails.forEach((img) => {
    img.addEventListener("click", () => {
      zoomContainer.src = img.src;
    });
  });

  const descriptionBtn = document.getElementById("descriptionBtn");
  const additionalInfoBtn = document.getElementById("additionalInfoBtn");
  const reviewsBtn = document.getElementById("reviewsBtn");
  const infoContainer = document.getElementById("infoContainer");
  const tabButtons = [descriptionBtn, additionalInfoBtn, reviewsBtn];

  function setActiveTab(activeBtn) {
    tabButtons.forEach((btn) => {
      btn.classList.remove("border-b");
      btn.classList.add("text-gray");
    });
    activeBtn.classList.remove("text-gray");
    activeBtn.classList.add("border-b");
  }

  descriptionBtn.addEventListener("click", () => {
    setActiveTab(descriptionBtn);
    infoContainer.innerHTML = `
    <div class="flex flex-col flex-1 min-w-0 gap-10">
      <p class="text-gray text-[14px]">
        Lorem Ipsum is simply dummy text of the printing and typesetting
        industry. Lorem Ipsum has been the 's standard dummy text. Lorem Ipsum
        has been the industry's standard dummy text ever since. Lorem Ipsum is
        simply dummy text.
      </p>
      <div>
        <h4 class="text-[14px]">01. Matte gunmetal stainless steel link</h4>
        <p class="text-gray text-[14px]">
          Any agreement with should have strong verification and enforcement
          safeguards to prevent future cheating.lorem Ipsum is simply dummy
          text of industry
        </p>
      </div>
      <div>
        <h4 class="text-[14px]">02. Brushed taupe stainless steel</h4>
        <p class="text-gray text-[14px]">
          Any agreement with should have strong verification and enforcement
          safeguards to prevent future cheating.lorem Ipsum is simply dummy
          text of industry
        </p>
      </div>
      <div>
        <h4 class="text-[14px]">03. Gunmetal hands and black markers</h4>
        <p class="text-gray text-[14px]">
          Any agreement with should have strong verification and enforcement
          safeguards to prevent future cheating.lorem Ipsum is simply dummy
          text of industry
        </p>
      </div>
    </div>
    <img
      src="/src/assets/images/product/watch-product-style-01-d.jpg.webp"
      alt=""
      class="flex-1 min-w-0 max-w-[550px] max-h-[520px] object-cover"
    />
  `;
  });

additionalInfoBtn.addEventListener("click", () => {
  setActiveTab(additionalInfoBtn);
  infoContainer.innerHTML = `
    <div class="flex-1 w-full">
      <table class="w-full table-fixed text-[14px]">
        <tbody>
          <tr class="border-b border-gray-200">
            <th class="w-1/3 py-4 pl-2 text-left font-semibold align-top">Color</th>
            <td class="py-4 text-gray"><p>Black, Blue, Brown, Green</p></td>
          </tr>
          <tr class="border-b border-gray-200 bg-gray-50">
            <th class="py-4 text-left font-semibold align-top pl-2">Size</th>
            <td class="py-4 text-gray"><p>39MM, 40MM, 41MM</p></td>
          </tr>
          <tr class="border-b border-gray-200">
            <th class="py-4 text-left font-semibold align-top pl-2">Style/Type</th>
            <td class="py-4 text-gray"><p>Sports, Formal</p></td>
          </tr>
          <tr class="border-b border-gray-200 bg-gray-50">
            <th class="py-4 text-left font-semibold align-top pl-2">Movement</th>
            <td class="py-4 text-gray"><p>Battery Powered 5 Hand Miyota with Center Chronograph Hand</p></td>
          </tr>
          <tr>
            <th class="py-4 text-left font-semibold align-top pl-2">Case</th>
            <td class="py-4 text-gray"><p>Matte Gunmetal Stainless Steel</p></td>
          </tr>
        </tbody>
      </table>
    </div>
  `;
});

  reviewsBtn.addEventListener("click", () => {
    setActiveTab(reviewsBtn);

    const starsHTML = [1, 2, 3, 4, 5]
      .map(
        (star) => `
      <button
        type="button"
        class="rating-star text-transparent [-webkit-text-stroke:1px_orange] text-xl transition-colors text-[14px]"
        data-value="${star}"
      >
        <i class="fa-solid fa-star"></i>
      </button>`,
      )
      .join("");

    infoContainer.innerHTML = `
    <div class="flex flex-col gap-5 w-full">
      <div id="reviews" class="flex flex-col space-y-6">
        <div class="flex justify-between items-start w-full gap-140 border-b border-gray/20 pb-6">
          <div class="flex gap-3">
            <img src="https://picsum.photos/200" alt="" class="w-[65px] h-[65px] rounded-full" />
            <div class="flex flex-col">
              <p class="text-[13px]">Alexis Ran <span class="text-gray">– May 10, 2019</span></p>
              <p class="text-[14px]">Lorem Ipsum is simply dummy text of the printing and typesetting industry</p>
            </div>
          </div>
          <span class="flex">
            <i class="fa-solid fa-star text-orange-400 text-[12px]"></i>
            <i class="fa-solid fa-star text-orange-400 text-[12px]"></i>
            <i class="fa-solid fa-star text-orange-400 text-[12px]"></i>
            <i class="fa-solid fa-star text-orange-400 text-[12px]"></i>
            <i class="fa-solid fa-star text-orange-400 text-[12px]"></i>
          </span>
        </div>
      </div>

      <div class="flex flex-col gap-1">
        <h4 class="text-[14px] uppercase">Add a review</h4>
        <p class="text-[12px] text-gray">Your email address will not be published. Required fields are marked *</p>
        <form id="formulario" action="" class="flex flex-col gap-6 mt-6 w-full">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex flex-col gap-2">
              <label for="name" class="text-[12px] font-medium">Name*</label>
              <input id="name" name="name" type="text" required
                class="border border-gray/30 px-4 py-3 outline-none focus:border-black max-w-[530px] max-h-[42px] px-[15px] py-[10px]" />
            </div>
            <div class="flex flex-col gap-2">
              <label for="email" class="text-[12px] font-medium">Email*</label>
              <input id="email" name="email" type="email" required
                class="border border-gray/30 px-4 py-3 outline-none focus:border-black max-w-[530px] max-h-[42px] px-[15px] py-[10px]" />
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <label class="text-[12px] font-medium">Your rating</label>
            <div class="flex flex-col gap-3">
              <div id="rating" class="flex gap-1">
                ${starsHTML}
              </div>
              <input type="hidden" name="rating" id="ratingValue" required />
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="review" class="text-[12px] font-medium">Your review*</label>
            <textarea id="review" name="review" rows="6" required
              class="border border-gray/30 px-4 py-3 resize-none outline-none focus:border-black max-w-[1140px] max-h-[105px] px-[15px] py-[9px]"></textarea>
          </div>

          <button type="submit"
            class="self-start bg-black text-white uppercase text-[13px] px-[20px] py-[3px] border border-transparent hover:bg-transparent hover:text-black hover:border-black transition-all ease-out duration-300">
            Submit
          </button>
        </form>
      </div>
    </div>
  `;

    // Recién ahora existen el form y las estrellas: los activamos
    initReviewForm();
  });

  function initReviewForm() {
    const stars = document.querySelectorAll(".rating-star");
    const input = document.getElementById("ratingValue");
    const form = document.getElementById("formulario");
    let selected = 0;

    function paint(value) {
      stars.forEach((star, index) => {
        if (index < value) {
          star.classList.remove("text-transparent");
          star.classList.add("text-orange-400");
        } else {
          star.classList.remove("text-orange-400");
          star.classList.add("text-transparent");
        }
      });
    }

    stars.forEach((star, index) => {
      star.addEventListener("mouseenter", () => paint(index + 1));
      star.addEventListener("mouseleave", () => paint(selected));
      star.addEventListener("click", () => {
        selected = index + 1;
        input.value = selected;
        paint(selected);
      });
    });

    paint(0);

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const name = document.getElementById("name").value;
      const review = document.getElementById("review").value;
      const rating = Number(input.value);

      const today = new Date().toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      });

      let starsMarkup = "";
      for (let i = 1; i <= 5; i++) {
        starsMarkup +=
          i <= rating
            ? `<i class="fa-solid fa-star text-orange-400 text-[12px]"></i>`
            : `<i class="fa-solid fa-star text-transparent [-webkit-text-stroke:1px_orange] text-[12px]"></i>`;
      }

      const reviewHTML = `
      <div class="flex justify-between items-start w-full gap-140 border-b border-gray/20 pb-6">
        <div class="flex gap-3">
          <img src="https://picsum.photos/200" alt="" class="w-[65px] h-[65px] rounded-full" />
          <div class="flex flex-col">
            <p class="text-[13px]">${name} <span class="text-gray">– ${today}</span></p>
            <p class="text-[14px]">${review}</p>
          </div>
        </div>
        <span class="flex">${starsMarkup}</span>
      </div>
    `;

      document
        .getElementById("reviews")
        .insertAdjacentHTML("beforeend", reviewHTML);

      form.reset();
      selected = 0;
      input.value = "";
      paint(0);
    });
  }
</script>
