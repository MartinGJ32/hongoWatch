          <button
            class="flex items-center justify-center w-[30px] w-[20px] px-5 border border-gray/50 cursor-pointer uppercase text-[11px] text-gray"
            >40mm</button
          >
          <button
            class="flex items-center justify-center w-[30px] w-[20px] px-5 border border-gray/50 cursor-pointer uppercase text-[11px] text-gray"
            >41mm</button
          >

          <a href="" class="uppercase text-[11px] underline">size guide</a>
        </div>
        <div class="flex gap-4">
          <div class="flex items-center">
            <p
              class="w-[39px] h-[39px] border border-gray/50 flex justify-center items-center"
            >
              1
            </p><div class="flex flex-col">
              <button
                class="w-[20px] h-[20px] border border-gray/50 flex justify-center items-center"
                >+</button
              ><button
                class="w-[20px] h-[20px] border border-gray/50 flex justify-center items-center"
