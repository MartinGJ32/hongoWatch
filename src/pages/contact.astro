---
import Layout from "../layouts/Layout.astro";
import teamImg from "../assets/images/contact/watch-the-team-01.jpg";
import womanBeachImg from "../assets/images/contact/contact-classic-img-22-1.jpg";
import beachImg from "../assets/images/contact/contact-classic-img-20.jpg";
import Hero from "../components/general/hero.astro";
---

<Layout name="Hongo - Contact">
  <!-- Hero -->
  <Hero title="Contact classic" description="the truth touches us" image={teamImg.src} />
  <section
    class="flex flex-col w-full h-full bg-[#f7f7f7] py-12 px-6 sm:py-16 sm:px-10 lg:py-25 lg:px-20 items-center justify-center"
  >
    <div class="flex flex-col max-w-90 items-center justify-center space-y-3">
      <h3 class="text-gold text-[12px]">STAY TOUCH WITH US</h3>
      <p class="text-[20px] sm:text-[22px] lg:text-[25px] text-center">
        Contact us to find out more or how we can help you
      </p>
    </div>
    <div class="grid grid-cols-4"></div>
  </section>



  
  <!-- numbers section -->
  <section class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 lg:gap-8 w-full py-12 px-6 sm:py-16 sm:px-10 lg:py-20 lg:px-20 bg-white">
    <div
      class="transition-all delay-150 duration-300 ease-in-out px-3 py-8 sm:px-5 sm:py-14 w-full h-auto sm:w-57 sm:h-14 flex flex-col justify-center items-center border-4 border-transparent hover:border-gold"
    >
      <p class="text-[28px] sm:text-[34px] lg:text-[40px]">22</p><h4 class="text-[11px] uppercase">
        HAPPY CLIENTS
      </h4>
    </div>
    <div
      class="transition-all delay-150 duration-300 ease-in-out px-3 py-8 sm:px-5 sm:py-14 w-full h-auto sm:w-57 sm:h-14 flex flex-col justify-center items-center border-4 border-transparent hover:border-gold"
    >
      <p class="text-[28px] sm:text-[34px] lg:text-[40px]">33</p><h4 class="text-[11px] uppercase">
        work completed
      </h4>
    </div>
    <div
      class="transition-all delay-150 duration-300 ease-in-out px-3 py-8 sm:px-5 sm:py-14 w-full h-auto sm:w-57 sm:h-14 flex flex-col justify-center items-center border-4 border-transparent hover:border-gold"
    >
      <p class="text-[28px] sm:text-[34px] lg:text-[40px]">52</p><h4 class="text-[11px] uppercase">
        award winning
      </h4>
    </div>
    <div
      class="transition-all delay-150 duration-300 ease-in-out px-3 py-8 sm:px-5 sm:py-14 w-full h-auto sm:w-57 sm:h-14 flex flex-col justify-center items-center border-4 border-transparent hover:border-gold"
    >
      <p class="text-[28px] sm:text-[34px] lg:text-[40px]">28</p><h4 class="text-[11px] uppercase">
        TELEPHONIC TALK
      </h4>
    </div>
  </section>





  <!-- contact info section -->
  <section
    class="w-full h-auto min-h-[600px] sm:min-h-[800px] lg:h-250 relative items-center justify-center flex flex-col space-y-10 sm:space-y-16 lg:space-y-30 bg-white py-14 lg:py-0"
  >
    <img
      src={womanBeachImg.src}
      alt=""
      class="absolute inset-0 w-full h-1/2 object-cover object-top "
    />
     <div class="absolute inset-0 h-1/2 bg-gold/80"></div>
    <h3 class="z-10 relative items-center text-center text-[36px] sm:text-[55px] md:text-[65px] lg:text-[80px] text-white">we would love</h3>
    <div class="z-10 relative flex flex-col lg:flex-row items-center gap-4 lg:gap-0 w-full px-6 lg:px-0 lg:w-auto">
      <div
        class="w-full max-w-[320px] h-64 sm:h-80 lg:w-120 lg:h-120 lg:max-w-none bg-[url(../assets/images/contact/watch-57.jpg)] bg-cover bg-center border-10 border-white"
      >
      </div>
      <div
        class="w-full max-w-[320px] h-64 sm:h-80 lg:w-120 lg:h-120 lg:max-w-none bg-[url(../assets/images/contact/download.jpeg)] bg-cover bg-center border-10 border-white"
      >
      </div>
      <div
        class="w-full max-w-[320px] lg:max-w-none min-h-[300px] lg:w-120 lg:h-120 bg-dark bg-cover bg-center border-10 border-white p-6 sm:p-8 lg:p-10 flex flex-col justify-center items-center gap-8"
      >
        <h4 class="text-[30px] text-white">How we can help you?</h4>
        <div
          class="flex items-start justify-center gap-5 border-b border-gray/50 w-60 pb-5"
        >
          <i class="text-gold text-[40px] fa-solid fa-headphones"></i><div class="flex flex-col items-start justify-center">
            <p class="text-white text-[12px]">
              Have any questions? Reach us by phone
            </p><p class="text-gray text-[12px]">
              1-800-222-000 / 1-800-222-002
            </p>
          </div>
        </div>

        <div
          class="flex items-startr justify-center gap-5 border-b border-gray/50 w-60 pb-5"
        >
          <i class="text-gold text-[40px] fa-solid fa-envelope"></i><div class="flex flex-col items-start justify-center">
            <p class="text-white text-[12px]">
              We're here for you! Just get answers
            </p><p class="text-gray text-[12px]">
              info@domain.com / services@domain.com
            </p>
          </div>
        </div>

        <div
          class="flex items-start justify-center gap-5 border-b border-gray/50 w-60 pb-5"
        >
          <i class="text-gold text-[40px] fa-solid fa-pen-to-square"></i><div class="flex flex-col items-start justify-center">
            <p class="text-white text-[12px]">
              Explore most popular help topics
            </p><p class="text-gray text-[12px]">
              Lorem ipsum is simply dummy text typesetting
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="mx-6 sm:mx-10 lg:mx-20 z-10 relative grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-10 lg:gap-20 items-start">
  <p class="text-[18px] sm:text-[20px] lg:text-[22px] text-dark leading-snug">
    You could argue that fashion has been playing the content marketing game
    for a long time now. Fashion shop feelings and relax day enjoy happy
    weekend!
  </p>
  <p class="text-[14px] sm:text-[15px] text-gray leading-relaxed">
    Lorem Ipsum is simply dummy text of the typesetting industry It has
    survived not only five centuries, but also the leap into electronic
    typesetting, remaining essentially of unchanged lorem Ipsum is simply
    dummy text of the printing and text typesetting industry. Lorem Ipsum is
    simply dummy text of the printing and industry. Lorem Ipsum is simply
    dummy text of the typesetting industry It has survived not only five
    centuries.
  </p>
</div>





  <!-- form section -->
  </section>
  <section class="flex flex-col lg:flex-row h-auto lg:h-197 w-full">
    <iframe
      class="h-64 sm:h-96 lg:h-197 w-full lg:w-197 grayscale"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3151.865498813894!2d144.96880199999998!3d-37.81661929999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6ad65d4c2b349649%3A0xb6899234e561db11!2sEnvato%20Pty%20Ltd!5e0!3m2!1sen!2sar!4v1783456289902!5m2!1sen!2sar"
      width="600"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"></iframe>
    <div
      class="h-auto lg:h-full w-full lg:w-160 bg-dark flex flex-col justify-center p-8 sm:p-12 lg:p-[114px] gap-6 sm:gap-10 lg:gap-15"
    >
      <div class="flex flex-col space-y-2">
        <p class="text-gold uppercase text-[12px]">
          FILL OUT THE FORM AND WE'LL GET BACK SOON!
        </p>
        <p class="text-white text-[20px] sm:text-[22px] lg:text-[25px]">
          Contact us to find out more or how we can help you
        </p>
      </div>

      <form id="contact-form" novalidate class="flex flex-col gap-6 sm:gap-8 lg:gap-10">
        <div class="flex flex-col gap-1.5">
          <input
            type="text"
            name="name"
            id="contact-name"
            placeholder="Name*"
            required
            class="w-full text-gray font-light border-b border-gray text-[15px] pb-1.5"
          />
          <p id="error-name" class="hidden text-[12px] text-red-400"></p>
        </div>

        <div class="flex flex-col gap-1.5">
          <input
            type="email"
            name="email"
            id="contact-email"
            placeholder="email*"
            required
            class="w-full text-gray font-light border-b border-gray text-[15px] pb-1.5"
          />
          <p id="error-email" class="hidden text-[12px] text-red-400"></p>
        </div>

        <input
          type="text"
          name="subject"
          id="contact-subject"
          placeholder="Subject"
          class="w-full text-gray font-light border-b border-gray text-[15px] pb-1.5"
        />

        <div class="flex flex-col gap-1.5">
          <textarea
            name="message"
            id="contact-message"
            placeholder="Your mensaje"
            required
            class="w-full text-gray font-light border-b border-gray text-[15px] pb-1.5"
          ></textarea>
          <p id="error-message" class="hidden text-[12px] text-red-400"></p>
        </div>

        <input
          type="submit"
          value="Send message"
          class="self-start px-[18px] py-[5px] bg-white text-[11px] uppercase cursor-pointer border-2 border-gray hover:border-white hover:bg-transparent hover:text-white"
        />
      </form>

      <div id="form-success" class="hidden flex flex-col gap-3 justify-center items-center border-2 p-2 border-gold">
        <p class="text-gold uppercase text-[12px]">Message sent</p>
        <p class="text-white text-[20px] sm:text-[22px] lg:text-[25px] text-center">
          Thanks for reaching out we'll get back to you soon.
        </p>
        <button
          type="button"
          id="form-success-reset"
          class="self-end text-[12px] text-gray underline decoration-2 underline-offset-2 hover:text-white"
        >
          Send another message
        </button>
      </div>
    </div>
    <img src={beachImg.src} alt="" class="hidden lg:block w-[470px] object-cover" />
  </section>




  <!-- free shipping section-->
  <section
    class="flex flex-col lg:flex-row w-full h-full bg-white py-12 px-6 sm:py-16 sm:px-10 lg:py-25 lg:px-20 items-center justify-center gap-6 lg:gap-10 text-center lg:text-left"
  >
    <h3
      class="text-[24px] sm:text-[28px] lg:text-[34px] uppercase border-b lg:border-b-0 lg:border-r pb-4 lg:pb-0 lg:pr-10 h-auto lg:h-9 flex items-center justify-center border-gray"
    >
      free SHIPPING
    </h3>
    <p class="text-[16px] max-w-70 sm:max-w-50 text-gray">
      Easy return-free shipping on all orders over £99
    </p>
    <button class="bg-gold text-white h-9 w-40">shop colletion</button>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form");
  const successMessage = document.getElementById("form-success");
  const resetButton = document.getElementById("form-success-reset");

  const fields = [
    {
      input: document.getElementById("contact-name"),
      error: document.getElementById("error-name"),
      message: "Please enter your name.",
      validate: function (value) {
        return value.trim().length > 0;
      },
    },
    {
      input: document.getElementById("contact-email"),
      error: document.getElementById("error-email"),
      message: "Please enter a valid email address.",
      validate: function (value) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim());
      },
    },
    {
      input: document.getElementById("contact-message"),
      error: document.getElementById("error-message"),
      message: "Please write your message.",
      validate: function (value) {
        return value.trim().length > 0;
      },
    },
  ];

  function setError(field) {
    field.input.classList.remove("border-gray");
    field.input.classList.add("border-red-400");
    field.error.textContent = field.message;
    field.error.classList.remove("hidden");
  }

  function clearError(field) {
    field.input.classList.remove("border-red-400");
    field.input.classList.add("border-gray");
    field.error.classList.add("hidden");
  }

  fields.forEach(function (field) {
    field.input.addEventListener("input", function () {
      clearError(field);
    });
  });

  form.addEventListener("submit", function (event) {
    event.preventDefault();

    let isValid = true;

    fields.forEach(function (field) {
      const value = field.input.value;
      if (field.validate(value)) {
        clearError(field);
      } else {
        setError(field);
        isValid = false;
      }
    });

    if (!isValid) return;

    form.reset();
    form.classList.add("hidden");
    successMessage.classList.remove("hidden");
  });

  resetButton.addEventListener("click", function () {
    successMessage.classList.add("hidden");
    form.classList.remove("hidden");
  });
</script>