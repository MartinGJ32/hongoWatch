           [&_th]:min-w-[107px] [&_th]:min-h-[23px]
           [&_td]:min-w-[107px] [&_td]:min-h-[23px]
           [&_td]:border [&_td]:border-gray/20 [&_td]:text-white dark:[&_td]:border-dark-border"
  >
    <thead class="bg-white/10 text-[13px]">
      <tr class="px-[14px] py-[10px] text-white">
