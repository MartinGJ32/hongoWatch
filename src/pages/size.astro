---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/general/hero.astro";
import WathcTitle from "../assets/images/size/watch-title-img-01-1.jpg";
import Wathc1 from "../assets/images/size/watch-size-guide-03.jpg";
import Wathc2 from "../assets/images/size/watch-size-guide-04.jpg";
---

<Layout name="Hongo - Size guide">
  <!--hero section -->
  <Hero
    title="Size guide"
    description="size & fit guide link"
    image={WathcTitle.src}
  />
  



  <!--woman table section -->
  <section class="flex-center-column w-full h-auto py-10 px-4 sm:px-6 md:py-14 md:px-10 lg:py-20 lg:px-20 gap-8 md:gap-14 lg:gap-20 bg-white/50 dark:bg-dark-surface">
    <h3 class="font-bold text-[13px] dark:text-dark-text">WOMEN'S SIZE CHART CLOTHING FOR US</h3>
    <div class="w-full max-w-[1140px] overflow-x-auto md:flex md:justify-center">
    <table class="max-w-[1140px] border-collapse [&_th]:font-light
         [&_td]:font-light  [&_th]:px-[10px] [&_th]:py-[14px]
         [&_td]:px-[10px] [&_td]:py-[14px] [&_th]:min-w-[107px] [&_th]:min-h-[23px] [&_td]:min-w-[107px] [&_td]:min-h-[23px]  [&_td]:border [&_td]:border-gray/20 dark:[&_td]:border-dark-border dark:[&_td]:text-dark-text-muted">
  <thead class="bg-gold dark:bg-dark-gold text-[13px] ">
    <tr class="px-[14px] py-[10px] text-white">
      <th class="text-left w-[370px]">WOMAN SIZE CHART</th>
      <th>S</th>
      <th>M</th>
      <th>L</th>
      <th>XL</th>
      <th>XXL</th>
      <th>2XL</th>
    </tr>
  </thead>

  <tbody>
    <tr class="bg-gray/10 dark:bg-dark-surface-2">
      <td class="w-[370px]">Collar</td>
      <td class="text-center">14</td>
      <td class="text-center">15</td>
      <td class="text-center">16</td>
      <td class="text-center">17</td>
      <td class="text-center">18</td>
      <td class="text-center">19</td>
    </tr>

    <tr class="bg-white dark:bg-dark-bg">
      <td class="w-[370px]">Shoulder</td>
      <td class="text-center">16</td>
      <td class="text-center">17</td>
      <td class="text-center">18</td>
      <td class="text-center">19</td>
      <td class="text-center">20</td>
      <td class="text-center">21</td>
    </tr>

    <tr class="bg-gray/10 dark:bg-dark-surface-2">
      <td class="w-[370px]">Chest, waist, hips</td>
      <td class="text-center">28–29</td>
      <td class="text-center">30–31</td>
      <td class="text-center">32–33</td>
      <td class="text-center">34–35</td>
      <td class="text-center">36–37</td>
      <td class="text-center">38–39</td>
    </tr>

    <tr class="bg-white dark:bg-dark-bg">
      <td class="w-[370px]">Cuff</td>
      <td class="text-center">9</td>
      <td class="text-center">9.5</td>
      <td class="text-center">10</td>
      <td class="text-center">10.5</td>
      <td class="text-center">11</td>
      <td class="text-center">11.5</td>
    </tr>

    <tr class="bg-gray/10 dark:bg-dark-surface-2">
      <td class="w-[370px]">Short-sleeve length</td>
      <td class="text-center">10</td>
      <td class="text-center">10.5</td>
      <td class="text-center">11</td>
      <td class="text-center">11.5</td>
      <td class="text-center">12</td>
      <td class="text-center">12.5</td>
    </tr>

    <tr class="bg-white dark:bg-dark-bg">
      <td class="w-[370px]">Long-sleeve length</td>
      <td class="text-center">23</td>
      <td class="text-center">23.5</td>
      <td class="text-center">24</td>
      <td class="text-center">24.5</td>
      <td class="text-center">25</td>
      <td class="text-center">25.5</td>
    </tr>

    <tr class="bg-gray/10 dark:bg-dark-surface-2">
      <td class="w-[370px]">Arm Hole</td>
      <td class="text-center">22</td>
      <td class="text-center">22.5</td>
      <td class="text-center">23</td>
      <td class="text-center">23.5</td>
      <td class="text-center">24</td>
      <td class="text-center">24.5</td>
    </tr>

    <tr class="bg-white dark:bg-dark-bg">
      <td class="w-[370px]">Back length</td>
      <td class="text-center">30</td>
      <td class="text-center">32</td>
      <td class="text-center">34</td>
      <td class="text-center">36</td>
      <td class="text-center">38</td>
      <td class="text-center">40</td>
    </tr>
  </tbody>
</table>
    </div>
  </section>




  <!--blocks section -->
  <section
    class="flex-center-column lg:flex-row w-full h-auto py-10 px-4 sm:px-6 md:py-14 md:px-10 lg:py-20 lg:px-20 gap-8 md:gap-12 lg:gap-20 bg-white dark:bg-dark-bg"
  >
    <div class="flex flex-col gap-4 w-full lg:w-auto">
      <img src={Wathc1.src} class="w-full h-auto lg:w-[550px] lg:h-[250px]" alt="Wrist with a watch" />
      <img src={Wathc2.src} class="w-full h-auto lg:w-[550px] lg:h-[250px]" alt="Watch on a rock" />
    </div>
    <div class="flex flex-col w-full lg:max-w-[460px] lg:max-h-[540px] gap-3">
      <h4 class="text-[22px] dark:text-dark-text">
        These size charts apply to all the patterns in our site us and metric size charts
      </h4>
      <p class="section-subtitle dark:text-dark-text-muted">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
      </p>
      <div class="flex gap-2 border-b border-gray/30 dark:border-dark-border py-3">
        <i class="text-[14px] text-gold dark:text-dark-gold">01.</i>
        <p class="section-subtitle dark:text-dark-text-muted">
          <span class="underline font-medium dark:text-dark-text">Bust</span>  measure under the arms at fullest around the bust horizontally.
        </p>
      </div>

      <div class="flex gap-2 border-b border-gray/30 dark:border-dark-border py-3">
        <i class="text-[14px] text-gold dark:text-dark-gold">02.</i>
        <p class="section-subtitle dark:text-dark-text-muted">
          <span class="underline font-medium dark:text-dark-text">Bra</span>  measure under the bust area.
        </p>
      </div>

      <div class="flex gap-2 border-b border-gray/30 dark:border-dark-border py-3">
        <i class="text-[14px] text-gold dark:text-dark-gold">03.</i>
        <p class="section-subtitle dark:text-dark-text-muted">
          <span class="underline font-medium dark:text-dark-text">Waist</span>  measure around the natural waistline.
        </p>
      </div>

      <div class="flex gap-2 border-b border-gray/30 dark:border-dark-border py-3">
        <i class="text-[14px] text-gold dark:text-dark-gold">04.</i>
        <p class="section-subtitle dark:text-dark-text-muted">
          <span class="underline font-medium dark:text-dark-text">Hips</span>  with the feet together measure the fullest part.
        </p>
      </div>

      <div class="flex gap-2 py-3">
        <i class="text-[14px] text-gold dark:text-dark-gold">05.</i>
        <p class="section-subtitle dark:text-dark-text-muted">
          <span class="underline font-medium dark:text-dark-text">Inside Leg</span>  In bare feet take the measurement from the inside leg.
        </p>
      </div>
    </div>
  </section>
  



