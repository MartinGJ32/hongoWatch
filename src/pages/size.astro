        <td class="text-center">32</td>
        <td class="text-center">23.5</td>
        <td class="text-center">24</td>
        <td class="text-center">24.5</td>
      </tr>

      <tr class="bg-gray/10">
        <td class="w-[370px]">Back length</td>
        <td class="text-center">30</td>
        <td class="text-center">32</td>
